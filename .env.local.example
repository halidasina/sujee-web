# ============================================================
# WAJIB ISI sebelum deploy
# Salin file ini → .env.local dan isi semua nilai
# ============================================================

# WhatsApp short link (wa.link) — dah ada
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.link/j1c283

# WhatsApp nombor penuh — untuk pre-filled order message
# Cara dapat: WhatsApp Business → Settings → Business Profile
# Format: 601XXXXXXXX (tiada + atau -)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# TikTok
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@molifedelights

# ============================================================
# LALAMOVE API
# Cara dapat:
# 1. Login https://developers.lalamove.com/
# 2. Pergi Dashboard → Applications
# 3. Create/View app → copy API Key & Secret
# ============================================================
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_BASE_URL=https://rest.lalamove.com

# Lokasi Pickup (dah set untuk alamat Kajang anda)
PICKUP_LAT=2.9982
PICKUP_LNG=101.7945
PICKUP_ADDRESS=26, Jalan Taman Bangi Avenue 7/13, Taman Bangi Avenue, 43000 Kajang, Selangor

# ============================================================
# META PIXEL
# Cara setup:
# 1. Pergi https://business.facebook.com
# 2. Events Manager → Connect Data Sources → Web
# 3. Create Pixel → dapat Pixel ID (nombor panjang)
# ============================================================
NEXT_PUBLIC_META_PIXEL_ID=

# ============================================================
# GOOGLE ANALYTICS
# Cara setup:
# 1. Pergi https://analytics.google.com
# 2. Admin → Create Property → Web
# 3. Dapat Measurement ID (format: G-XXXXXXXXXX)
# ============================================================
NEXT_PUBLIC_GOOGLE_TAG_ID=
